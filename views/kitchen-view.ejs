<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/style.css">
    <style>
        body {
            background-color: #ff444a;
        }

        .order-card {
            border: 1px solid #D1282E;
            padding: 15px 20px;
            margin: 15px 0;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            max-width: 350px;
            width: 100%;
            background-color: #f9f9f9;
            margin-left: auto;
            margin-right: auto;
        }

        .page-wrapper {
            background-color: #f4f4f4;
            padding: 20px;
        }

        .order-card .card-header {
            font-size: 1.2em;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .container-card {
            font-size: 1.1em;
            margin-bottom: 10px;
        }

        .food-list {
            font-size: .8em;
            margin-left: 20px;
        }

        .food-list li {
            font-size: 1.1em;
        }

        .buttons-container {
            margin-top: 15px;
        }

        .buttons-container .btn {
            font-size: 1.1em;
            padding: 8px 15px;
        }


        .bump-button,
        .finish-button {
            padding: 8px 12px;
            margin: 4px;
            font-size: 0.9em;
            cursor: pointer;
            width: 100px;
        }

        .bump-button {

            color: white;
            border: none;
            border-radius: 5px;
        }

        .finish-button {
            background-color: #28a745;
            color: white;
            border: none;
            border-radius: 5px;
        }

        .bump-button:hover,
        .finish-button:hover {
            opacity: 0.8;
        }
    </style>

</head>

<nav class="navbar-color navbar navbar-expand-lg" style="color: white;">

    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse d-flex justify-content-between" id="navbarNav">
        <div> <a class="panda-logo navbar-brand">
                <img src="https://cdn.worldvectorlogo.com/logos/panda-express-logo-1.svg" alt="Panda Express Logo"
                    style="height: 40px;">
            </a>

        </div>



    </div>
</nav>

<body>

    <div class="container mt-4">
        <div class="row">
            <% orders.forEach(order=> { %>
                <div class="col-sm-12 col-md-6 col-lg-4">
                    <div class="order-card card">
                        <!-- Order Header -->
                        <div class="card-header">
                            <strong>Order ID: </strong>
                            <%= order.order_id %><br>
                                <strong>Order Time: </strong>
                                <%= order.order_time %><br>


                        </div>

                        <!-- Loop through the containers for each order -->
                        <div class="card-body">
                            <% order.containers.forEach(container=> { %>
                                <div class="container-card card mb-3">
                                    <strong>Container: </strong>
                                    <%= container.container_name %><br>
                                        <strong>Food Items:</strong>
                                        <ul class="food-list">
                                            <% container.food_items.forEach(food=> { %>
                                                <li>
                                                    <%= food.food_name %>
                                                </li>
                                                <% }); %>
                                        </ul>
                                </div>
                                <% }); %>
                        </div>

                        <div class="buttons-container text-center">
                            <button class="btn btn-danger bump-button"
                                onclick="bumpOrder(<%= order.order_id %>)">Bump</button>
                                <button class="btn btn-outline-danger recall-button"
                                onclick="recallOrder(<%= order.order_id %>)">Recall</button>
                                <button class="btn btn-success finish-button"
                                onclick="finishOrder(<%= order.order_id %>)">Finish</button>
                          
                        </div>
                    </div>
                </div>
                <% }); %>
        </div>
    </div>





    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.min.js"></script>

    <script>
        function bumpOrder(orderId) {
            
            // Send a request to the server to bump this order
            fetch(`/bumpOrder/${orderId}`, {
                method: 'POST', // Use POST or PUT depending on your action
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ orderId: orderId }) // Send the order ID in the body
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Order bumped successfully!');
                        // Optionally, reload the page or update the UI to reflect the change
                        location.reload();
                    } else {
                        alert('Failed to bump order.');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error bumping order.');
                });
        }

        function recallOrder(orderId) {
           
            // Send a request to the server to bump this order
            fetch(`/recallOrder/${orderId}`, {
                method: 'POST', // Use POST or PUT depending on your action
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ orderId: orderId }) // Send the order ID in the body
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Order recalled successfully!');
                        // Optionally, reload the page or update the UI to reflect the change
                        location.reload();
                    } else {
                        alert('Failed to bump order.');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error recalling order.');
                });
        }

        function finishOrder(orderId) {
            //console.log('hi');
            // Send a request to the server to bump this order
            fetch(`/finishOrder/${orderId}`, {
                method: 'POST', // Use POST or PUT depending on your action
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ orderId: orderId }) // Send the order ID in the body
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Order fulfilled successfully!');
                        // Optionally, reload the page or update the UI to reflect the change
                        location.reload();
                    } else {
                        alert('Failed to fulfill order.');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error bumping order.');
                });
        }
    </script>

<script>
    setInterval(function() {
        location.reload();
    }, 10000); // 15000ms = 15 seconds
</script>


</body>



</html>