                                            <td><%= item.container_type %></td> <!-- Match 'date' -->
                                            <td><%= item.quantity_sold %></td> <!-- Match 'food_name' instead of 'ingredient' -->
                                            <td><%= '$' + (item.total_revenue / 100).toFixed(2) %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
