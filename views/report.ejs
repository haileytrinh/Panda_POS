    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.min.js"
        integrity="sha384-cuYeSxntonz0PPNlHhBs68uyIAVpIIOZZ5JqeqvYYIcEL727kskC66kF92t6Xl2V"
        crossorigin="anonymous"></script>

    <!-- Flatpickr JS for the date picker functionality -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        // Initialize Flatpickr for date inputs with MM/DD/YYYY format
        flatpickr(".datepicker", {
            dateFormat: "m/d/Y", // Format as Month/Day/Year
            allowInput: true
        });
    </script>

    <!-- Include Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
    /**
    * @file        Displays various reports that the manager might want to view for information
    */
        document.addEventListener("DOMContentLoaded", function() {
       

        // Function to format date as MM/DD/YYYY
        /**
        * @function formatDate
        * @description displays the date correctly in month/day/year format
        * @param {object} date - takes a computer generated date object in for processing
        */
        function formatDate(date) {
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            const year = date.getFullYear();
            return `${month}/${day}/${year}`;
        }



        function formatTime(hour) {
            const period = hour >= 12 ? 'PM' : 'AM';
            const formattedHour = hour % 12 === 0 ? 12 : hour % 12;
            const minutes = '00';  // Assuming you are not storing minutes; if you have minutes, format accordingly.
            return `${formattedHour}:00 ${period}`;
        }

        // Handle "Run Report" button click for Product Usage
        /**
        * @function handleRunReportClick
        * @description loads in the report when the manager clicks run
        * @param {string} reportType - tracks what report type we have chosen and loads the correct data
        */
        function handleRunReportClick(reportType) {
            let startDate = "";
            let endDate = "";
            let startTime = "";
            let endTime = "";
            if (reportType === 'sales') { // actually sales report
                startDate = document.getElementById("startDate1").value;
                endDate = document.getElementById("endDate1").value;
                startTime = document.getElementById("startTime1").value;
                endTime = document.getElementById("endTime1").value;
            } else if (reportType === 'productUsage') { // actually product usage
                startDate = document.getElementById("startDate2").value;    
                endDate = document.getElementById("endDate2").value;  
                startTime = document.getElementById("startTime2").value;
                endTime = document.getElementById("endTime2").value;             
            }

            console.log("Report Type:", reportType);
            console.log("Start Date:", startDate);
            console.log("End Date:", endDate);
            console.log("Start Time:", startTime);
            console.log("End Time:", endTime);
            $.ajax({
                url: '/generate-report', 
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ startDate, endDate, startTime, endTime, reportType }),

                success: function(response) {
                    console.log("AJAX response:", response); // Log the full response for debugging
                    if (response) {
                        
                        if (reportType === 'sales' && response.salesReport) {
                            updateReportTable(response.salesReport, 'sales');
                            renderReport(response.salesReport, 'sales')
                        } else if (reportType === 'productUsage' && response.productUsageReport) {
                            updateReportTable(response.productUsageReport, 'productUsage');
                            renderReport(response.productUsageReport, 'productUsage')

                        } else if (reportType === 'xReport' && response.dailyReport) {
                            updateReportTable(response.dailyReport, 'xReport');
                        } else if (reportType === 'zReport' && response.dailyReport) {
                            updateReportTable(response.dailyReport, 'zReport');
                        } else {
                            console.error("Unexpected response format:", response);
                        }
                    }
                },
                error: function(xhr, status, error) {
                    console.error("Error fetching report data:", error);
                    console.error("Response Text:", xhr.responseText);
                    console.error("Status Text:", xhr.statusText);
                    console.error("Status Code:", xhr.status);
                }

            });
        }

        // Update the report table with new data
        /**
        * @function updateReportTable
        * @description updates the report data with new information as it comes in
        * @param {object} data - a specified date range for the displayed data
        * @param {string} reportType - tracks what report type we have chosen and loads the correct data
        */
        function updateReportTable(data, reportType) {
            let tableBody;

            if (reportType === 'sales') {
                tableBody = document.getElementById("reportTableBody1");
            } else if (reportType === 'productUsage') {
                tableBody = document.getElementById("reportTableBody2");
            } else if (reportType === 'xReport') {
                tableBody = document.getElementById("dailyReportTableBody");
            } else if (reportType === 'zReport') {
                tableBody = document.getElementById("dailyReportTableBody");
            } else {
                console.error("Invalid reportType provided.");
            }

            tableBody.innerHTML = ''; // Clear existing rows

            if (data.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="3">No data available for the selected date range.</td></tr>';
                return;
            }

            data.forEach(item => {
                const row = document.createElement("tr");
                if (reportType === 'sales') {
                    row.innerHTML = `<td>${item.container_type}</td><td>${item.quantity_sold}</td><td>$${(item.total_revenue / 100).toFixed(2)}</td>`;
                } else if (reportType === 'productUsage') {
                    row.innerHTML = `<td>${item.ingredient}</td><td>${item.quantity_used}</td>`;
                } else if (reportType === 'xReport') {
                    row.innerHTML = `<td>${formatTime(item.hour)}</td><td>${item.sales}</td><td>$${(item.price / 100).toFixed(2)}</td>`;
                } else if (reportType === 'zReport') {
                    row.innerHTML = `<td>${formatTime(item.hour)}</td><td>${item.sales}</td><td>$${(item.price / 100).toFixed(2)}</td>`;
                }
                tableBody.appendChild(row);
            });
        }


        
        // Event listener for Product Usage Report button
        document.getElementById("runReportBtn1").addEventListener("click", function() {
            handleRunReportClick('sales');
        });

        // Event listener for Sales Report button
        document.getElementById("runReportBtn2").addEventListener("click", function() {
            handleRunReportClick('productUsage');
        });


        // Event listener for X Report button
        document.getElementById("xReportButton").addEventListener("click", function() {
            handleRunReportClick('xReport');

        });
        
        // Event listener for Z Report button
        document.getElementById("zReportButton").addEventListener("click", function() {
            handleRunReportClick('zReport');
            document.getElementById("xReportButton").disabled = true;

        });
        









        // Global variables to store the Chart.js instances for both charts
let salesChartInstance = null;
let productUsageChartInstance = null;

function renderReport(report, reportType) {
    console.log("report before rendering:", report);

    if (!Array.isArray(report)) {
        console.error("report is not an array or is undefined:", report);
        return;
    }

    // Determine which canvas to use based on reportType
    let canvasId = '';
    let chartData = {};
    let chartLabels = [];
    let chartQuantities = [];
    let chartPrices = [];

    if (reportType === 'sales') {
        canvasId = 'salesChart'; // Set the canvas ID for sales chart
        // Sales chart data (menu items, total revenue, and quantities)
        chartLabels = report.map(item => item.container_type); // Menu items
        chartPrices = report.map(item => (item.total_revenue / 100).toFixed(2)); // Total prices
        chartQuantities = report.map(item => item.quantity_sold); // Quantities
    } else if (reportType === 'productUsage') {
        canvasId = 'productUsageChart'; // Set the canvas ID for product usage chart
        // Product usage chart data (ingredients and quantities)
        chartLabels = report.map(item => item.ingredient); // Ingredients
        chartQuantities = report.map(item => item.quantity_used); // Quantities
        chartPrices = null; // No price data for productUsageChart
    }

    // Destroy existing chart instance based on the chart type
    if (reportType === 'sales' && salesChartInstance) {
        salesChartInstance.destroy();
    } else if (reportType === 'productUsage' && productUsageChartInstance) {
        productUsageChartInstance.destroy();
    }

    const canvas = document.getElementById(canvasId);
    canvas.width = 600; // Set width
    canvas.height = 375; // Set height 

    // Chart.js configuration
    const ctx = canvas.getContext('2d');

    // Create or update the appropriate chart based on reportType
    if (reportType === 'sales') {
        salesChartInstance = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: chartLabels, // Menu items on X-axis
                datasets: [{
                    label: 'Quantity Sold',
                    data: chartPrices, // Total prices on Y-axis
                    backgroundColor: '#D1282E', // Red bars
                    borderColor: '#D1282E', // Red border
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Revenue ($)' // Y-axis title
                        }
                    }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function(tooltipItem) {
                                const index = tooltipItem.dataIndex;
                                return `Revenue: $${tooltipItem.raw} | Quantity Sold: ${chartQuantities[index]}`;
                            }
                        }
                    },
                    legend: {
                        display: false // Disable the legend
                    },
                    datalabels: {
                        anchor: 'end',
                        align: 'top',
                        formatter: function(value, context) {
                            const index = context.dataIndex;
                            return `Qty: ${chartQuantities[index]}`; // Display quantity above the bar
                        }
                    }
                }
            }
        });
    } else if (reportType === 'productUsage') {
        productUsageChartInstance = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: chartLabels, // Ingredients on X-axis
                datasets: [{
                    label: 'Quantity Used',
                    data: chartQuantities, // Quantities on Y-axis
                    backgroundColor: '#D1282E', // Red bars
                    borderColor: '#D1282E', // Red border
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Quantity Used' // Y-axis title for product usage
                        }
                    }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function(tooltipItem) {
                                const index = tooltipItem.dataIndex;
                                return `Quantity Used: ${tooltipItem.raw}`;
                            }
                        }
                    },
                    legend: {
                        display: false // Disable the legend
                    },
                    datalabels: {
                        anchor: 'end',
                        align: 'top',
                        formatter: function(value, context) {
                            const index = context.dataIndex;
                            return `Qty: ${chartQuantities[index]}`; // Display quantity above the bar
                        }
                    }
                }
            }
        });
    }
}






    });


    </script>





