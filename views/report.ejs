            <!-- Daily Report -->
            <div class="tab-pane fade" id="report3" role="tabpanel" aria-labelledby="report3-tab">
                <div class="table-responsive mt-3" >
                    <div class="col-md-3 d-flex align-items-end mb-4">
                        <button class="btn btn-primary w-100 me-2" id="xReportButton">X Report</button>
                        <button class="btn btn-primary w-100" id="zReportButton">Z Report</button>
                    </div>
                    
                    <table class="table table-bordered mt-4">
                        <thead class="table-dark">
                            <tr>
