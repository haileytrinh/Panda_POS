                <div class="row mt-3">

                    <div class="col-md-6"> <!-- Use col-md-6 for the left half -->
                        <!-- Product Usage Table -->
                        <div class="table-responsive mt-3">
                            <table class="table table-bordered">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Ingredient</th>
                                        <th>Quantity</th>
                                    </tr>
                                </thead>
                                <tbody id="reportTableBody2">
                                    <% foodReport2.forEach(item => { %>
