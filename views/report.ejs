                    <!-- Start Date -->
                    <div class="col-md-3">
                        <label for="startDate2">Start Date:</label>
                        <input type="text" id="startDate2" class="form-control datepicker" placeholder="Select start date">
                    </div>

                    <!-- End Date -->
                    <div class="col-md-3">
                        <label for="endDate2">End Date:</label>
                        <input type="text" id="endDate2" class="form-control datepicker" placeholder="Select end date">
