<% layout('partials/cashierBoilerPlate') %>

    <a href="/orders" class="btn btn-secondary btn-sm mb-3">
        ← Back</a>
    <div class="container mb-5">
        <h4 class="text-center mb-4">Viewing Order #<%= order.order_id %>
        </h4>


        <h3>Order Details:</h3>

        <% for (let containerName in containers) { %>
            <div class="container">
                <h4>Container: <%= containerName %>
                </h4>
                <ul>
                    <% containers[containerName].forEach(function(food) { %>
                        <li>
                            <%= food %>
                        </li>
                        <% }) %>
                </ul>
            </div>
            <% } %>


                <form action="/orders/<%= order.order_id %>?_method=PUT" method="POST">
                    <div class="mb-3">
                        <label for="status" class="fw-bold form-label">Status:</label>
                        <select id="status" name="status" class="form-select" required>
                            <option value="" <%=order.status===null ? 'selected' : '' %>>
                            </option>
                            <option value="fulfilled" <%=order.status==='fulfilled' ? 'selected' : '' %>>Fulfilled
                            </option>
                            <option value="cancelled" <%=order.status==='cancelled' ? 'selected' : '' %>>Cancelled
                            </option>
                            <option value="processing" <%=order.status==='processing' ? 'selected' : '' %>>Processing
                            </option>

                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Save Changes</button>


                </form>
                <form action="/orders/<%= order.order_id %>/delete" method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this item?')">

                    <button type="submit" class="btn btn-danger w-30 mt-3">Delete Menu Item</button>
                </form>