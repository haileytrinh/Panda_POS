
<% layout('partials/boilerplate') %>
<style>

    /* High Contrast Mode Styles */
    .high-contrast {
        background-color: #000 !important;
        color: #fff !important;
    }
    .high-contrast a {
        color: #ff0 !important;
    }
    .high-contrast .card {
        background-color: #d02020 !important;
    }
    .high-contrast .card-body {
        color: #fff !important;
    }
    .high-contrast .btn {
        background-color: rgb(255, 201, 52) !important;
        color: #000 !important;
    }
    .high-contrast .card-title, 
    .high-contrast .card-text,
    .high-contrast p {
        color: #fff !important; /* Ensure text is white in high contrast mode */
    }
</style>

<div id="content-container">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <!-- Left Section: Translate and TTS Buttons -->
        <div style="display: flex; align-items: center; gap: 20px;">
            <!-- Translate Section -->
            <div style="position: relative; display: inline-block;">
                <!-- Translate Button -->
                <button id="translateButton" aria-label="Translate" style="border: none; background: none;">
                    <img id="translate-icon" alt= "Translate" src="https://cdn2.iconfinder.com/data/icons/social-media-line/50/global-512.png" style="width: 30px; height: 30px;">
                </button>
        
                <!-- Dropdown Menu -->
                <div id="languageMenu" style="position: absolute; display: none; background-color: white; border: 1px solid #ccc; box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2); z-index: 1; min-width: 160px;">
                    <button id="englishOption" style="display: block; width: 100%; padding: 8px; text-align: left; border: none; background: none; cursor: pointer;">English</button>
                    <button id="spanishOption" style="display: block; width: 100%; padding: 8px; text-align: left; border: none; background: none; cursor: pointer;">Spanish</button>
                    <button id="chineseOption" style="display: block; width: 100%; padding: 8px; text-align: left; border: none; background: none; cursor: pointer;">Chinese</button>
                    <button id="frenchOption" style="display: block; width: 100%; padding: 8px; text-align: left; border: none; background: none; cursor: pointer;">French</button>
                </div>
            </div>
        
            <!-- TTS Section -->
            <button id="ttsToggle" aria-label="Text-to-Speech" style="border: none; background: none;">
                <img id="tts-icon" alt= "Text-to-Speech" src="https://icons.iconarchive.com/icons/pictogrammers/material-light/256/volume-high-icon.png" style="width: 40px; height: 40px;">
            </button>
        
            <!-- Font Settings Section -->
            <div>
                <button id="fontButton" style="border: none; background: none;">
                    <img id="font-icon" src="https://www.svgrepo.com/show/465105/font-3.svg" alt="Font Icon" style="width: 30px; height: 30px;">
                </button>
                <div id="fontControls" style="display: none; margin-top: 10px; background-color: #bfbfbf; padding: 10px; border: 1px solid #ccc; border-radius: 5px; width: fit-content;">
                    <label for="fontSelect" style="margin: 5px; font-size: 14px;">Change Font:</label>
                    <select id="fontSelect" style="margin: 5px; font-size: 14px;">
                        <option value="Arial">Arial</option>
                        <option value="Verdana">Verdana</option>
                        <option value="Times New Roman">Times New Roman</option>
                        <option value="Georgia">Georgia</option>
                        <option value="Courier New">Courier New</option>
                    </select>
                    <button id="increaseFont" style="margin: 5px; border: none; background: none;">
                        <img src="https://cdn0.iconfinder.com/data/icons/typicons-2/24/plus-128.png" alt="Font Icon" style="width: 20px; height: 20px;">
                    </button>
                    <button id="decreaseFont" style="margin: 5px; border: none; background: none;">
                        <img src="https://cdn0.iconfinder.com/data/icons/typicons-2/24/minus-128.png" alt="Font Icon" style="width: 20px; height: 20px;">
                    </button>
                </div>

            </div>

                <!-- High Contrast Toggle Button -->
                <button id="highContrastToggle" class="btn btn-warning" style="border: none; background: none;">
                    High Contrast
                </button>
        </div>
    
        <!-- Right Section: Weather Icon and Info -->
        <div id="weather" style="display: flex; align-items: center; text-align: right;">
            <img id="weatherIcon" src="" alt="Weather icon" style="width: 60px; height: 60px; margin-right: 10px;">
            <div style="display: flex; flex-direction: column; text-align: left;">
                <p style="margin-bottom: 2px; font-size: 14px;"><span id="temperature"></span></p>
                <p style="margin-top: 2px; margin-bottom: 0; text-transform: capitalize; font-size: 14px;"><span
                        id="weatherDescription"></span></p>
            </div>
        </div>
    </div>
    
    <style>
        /* Style for the dropdown menu */
        #languageMenu {
            position: absolute;
            display: none;
            background-color: white;
            border: 1px solid #ccc;
            box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
            z-index: 1;
        }
    
        #languageMenu button {
            display: block;
            width: 100%;
            padding: 8px;
            text-align: left;
            border: none;
            background: none;
            cursor: pointer;
        }
    
        #languageMenu button:hover {
            background-color: #f1f1f1;
        }
    </style>
    
    <h1 data-translate>Your Cart</h1>

    <div class="mb-4">

        <% if (cart && cart.length> 0) { %>
            <!-- Displays Each Container -->
            <% cart.forEach(order=> { %>

                <div class="card m-4">
                    <div class="card-body" data-translate-card>
                        <!-- Container Type -->
                        <h5 class="card-title" data-translate>
                            <%= order[2] %>
                        </h5>

                        <!-- Food Content & Price -->
                        <% if (order[2]=="Bowl" || order[2]=="Plate" || order[2]=="Bigger Plate") { %>
                            <p class="card-text" data-translate><strong>Entrees:</strong>
                                <%= order[3].join(' , ') %></p>
                            <p class="card-text" data-translate><strong>Sides:</strong>  <%= order[4].join(' , ') %></p>
                            <p class="card-text" data-translate><strong>Price:</strong>  $<%= (order[1] / 100).toFixed(2) %></p>
                            <button class="btn btn-danger delete-btn" onclick="deleteItem(<%= order[0] %>)">Delete</button>
                        <% } else if (order[2] == "A-La-Carte")  { %>
                            <p class="card-text"><strong>Entree/Side:</strong>
                                <%= order[3].join(' , ') %></p>
                            <p class="card-text"><strong>Price:</strong>  $<%= (order[1] / 100).toFixed(2) %></p>
                            <button class="btn btn-danger delete-btn" onclick="deleteItem(<%= order[0] %>)">Delete</button>
                        <% } else if (order[2] == "Appetizer")  { %>
                            <p class="card-text"><strong>Appetizer:</strong>
                                <%= order[3].join(' , ') %></p>
                            <p class="card-text"><strong>Price:</strong>  $<%= (order[1] / 100).toFixed(2) %></p>
                            <button class="btn btn-danger delete-btn" onclick="deleteItem(<%= order[0] %>)">Delete</button>
                        <% } else if (order[2] == "Drink")  { %>
                            <p class="card-text"><strong>Drink:</strong>
                                <%= order[3].join(' , ') %></p>
                            <p class="card-text"><strong>Price:</strong>  $<%= (order[1] / 100).toFixed(2) %></p>
                            <button class="btn btn-danger delete-btn" onclick="deleteItem(<%= order[0] %>)">Delete</button>
                        <% } %>
                    </div> 
                </div> 
            <% }) %>
            <!-- Total Price -->
            <h4 style="float: left;" data-translate>
                Total: $<span id="total-price">0.00</span>
            </h4>
            <!-- Complete Order Button -->
            <button class="btn btn-danger delete-btn" data-translate style="float: right; margin-bottom: 25px;" onclick="completeOrder()">Complete Order</button>
        <!-- Empty Cart -->
        <% } else { %>
            <p data-translate>Your cart is empty.</p>
            <div class="mb-3 text-center" >
                <a class="btn btn-danger " href ="/" data-translate>Start New Order</a>
            </div>
        <% } %>

    </div>
</div>

    <script>
        let totalPrice = 0;
        // Iterate over the items in cart and update the total price
        const cart = <%- JSON.stringify(cart) %>;
        cart.forEach(order => {
            updateTotalPrice(order[1]);
        });
        function updateTotalPrice(containerPrice) {
            totalPrice += containerPrice;
            document.getElementById('total-price').textContent = (totalPrice / 100).toFixed(2);
        }

        function deleteItem(orderId) {
            fetch(`/deleteItem/${orderId}`, {
                method: "DELETE", headers: { "Content-Type": "application/json" },
            }).then(response => {
                if (response.ok) {
                    // On success, remove the order from the DOM
                    const orderCard = document.getElementById(`order-${orderId}`);
                    if (orderCard) {
                        orderCard.remove();
                    }

                    location.reload();
                } else {
                    alert("Failed to delete item.");
                }
            })
                .catch(error => {
                    console.error('Error deleting item:', error); alert("Error deleting item.");
                });
        }

        const maxOrderId = <%= maxOrderId %>;
        async function completeOrder() {
            // Generate the new order_id
            const newOrderId = maxOrderId + 1; // Increment to get the new order_id

            // Get the exact date and time of the order
            const dateTime = new Date();
            const orderDate = dateTime.getFullYear() + `-` + (dateTime.getMonth() + 1) + `-` + dateTime.getDate();
            const orderTime = dateTime.getHours() + `:` + dateTime.getMinutes() + `:` + dateTime.getSeconds();

            // Order not taken by employee
            const employeeId = -1;

            // Send the cart and metadata to the server
            const customerOrder = {
                cart,                // Entire cart as an array
                order_id: newOrderId,
                employee_id: employeeId,
                date: orderDate,
                time: orderTime,
                is_in_process: 't',
                status: "processing"
            };

            // Send the cart to check for stock availability
            try {
                const checkResponse = await fetch('/checkIngredients', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ cart: customerOrder.cart })
                });

                const checkResult = await checkResponse.json();

                if (checkResult.unavailable && checkResult.unavailable.length > 0) {
                    // Alert the user about unavailable items
                    alert(`The following items are not available: ${checkResult.unavailable.join(', ')}. Please update your cart.`);
                    return; // Do not proceed with the order
                }
            } catch (error) {
                console.error('Error checking ingredients:', error);
                alert('Error checking ingredients. Please try again.');
                return;
            }

            fetch('/pushOrder', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(customerOrder)
            })
            .then(response => {
                if (response.ok) {
                    alert("Your order has been sent! Your order number is " + newOrderId + ".");
                    window.location.reload();

                } else {
                    alert("Failed to push the order to the database.");
                }
            })
            .catch(error => {
                console.error('Error pushing the order to the database:', error);
                alert("Error pushing the order to the database.");
            });
        }

    </script>
    
    <script type="text/javascript">
        /**
         * @file        Cart and Order Display Page with Translation Functionality
         */
    
        // Function to call the translation API
        async function translateText(text, targetLanguage) {
            const res = await fetch('/translate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text, targetLanguage }),
            });
    
            const data = await res.json();
            return data.translatedText;
        }
    
        // Function to translate a single element
        async function translateElement(element, targetLanguage) {
            const originalText = element.dataset.original || element.textContent;
    
            if (targetLanguage === 'en') {
                // Revert to original text
                element.textContent = originalText;
            } else {
                const translatedText = await translateText(originalText, targetLanguage);
                // Store the original text for reverting
                element.dataset.original = originalText;
                element.textContent = translatedText;
            }
        }
    
        // Function to translate the entire content container
        async function translateContent(container, targetLanguage) {
            // Translate elements with the data-translate attribute
            const translatableElements = container.querySelectorAll('[data-translate]');
            for (const element of translatableElements) {
                await translateElement(element, targetLanguage);
            }
    
            // Handle translation for elements in cards
            const cardElements = container.querySelectorAll('[data-translate-card]');
            for (const card of cardElements) {
                const cardTitle = card.querySelector('.card-title');
                const cardTexts = card.querySelectorAll('.card-text');
                const deleteButton = card.querySelector('.delete-btn');
    
                if (cardTitle) await translateElement(cardTitle, targetLanguage);
                for (const text of cardTexts) {
                    await translateElement(text, targetLanguage);
                }
                if (deleteButton) await translateElement(deleteButton, targetLanguage);
            }
        }
    
        // Initial setup
        document.addEventListener('DOMContentLoaded', async () => {
            const contentContainer = document.getElementById('content-container');
            const translateButton = document.getElementById('translateButton');
            const languageMenu = document.getElementById('languageMenu');
    
            // Retrieve saved language preference or default to English
            const savedLanguage = localStorage.getItem('language') || 'en';
            let currentLanguage = savedLanguage;
    
            // Apply saved language on page load
            if (currentLanguage !== 'en') {
                await translateContent(contentContainer, currentLanguage);
            }
    
            // Show language menu when translate button is clicked
            translateButton.addEventListener('click', () => {
                languageMenu.style.display = languageMenu.style.display === 'block' ? 'none' : 'block';
            });
    
            // Handle language change
            async function changeLanguage(language) {
                currentLanguage = language;
                await translateContent(contentContainer, language);
                localStorage.setItem('language', language);
                languageMenu.style.display = 'none'; // Hide the dropdown after selection
            }
    
            // Event listeners for language selection
            document.getElementById('englishOption').addEventListener('click', () => changeLanguage('en'));
            document.getElementById('spanishOption').addEventListener('click', () => changeLanguage('es'));
            document.getElementById('chineseOption').addEventListener('click', () => changeLanguage('zh'));
            document.getElementById('frenchOption').addEventListener('click', () => changeLanguage('fr'));
    
            // Close the dropdown when clicking anywhere outside it
            window.addEventListener('click', (event) => {
                if (!event.target.matches('#translateButton') && !event.target.matches('#languageMenu') && !event.target.matches('#languageMenu *')) {
                    languageMenu.style.display = 'none';
                }
            });
        });
    </script>
    

<script type="text/javascript">
    // Flag to track TTS toggle status
    let isTtsEnabled = false;

    // Function to toggle text-to-speech
    document.getElementById('ttsToggle').addEventListener('click', () => {
        isTtsEnabled = !isTtsEnabled;
        if (isTtsEnabled) {
            alert("Text-to-Speech is now ON. Select text to hear it.");
        } else {
            alert("Text-to-Speech is now OFF.");
        }
    });

    // Function to speak the selected text
    function speakText(text) {
        if (isTtsEnabled && text) {
            const utterance = new SpeechSynthesisUtterance(text);
            speechSynthesis.speak(utterance);
        }
    }

    // Detect text selection and trigger speech synthesis when selection is released
    document.addEventListener('mouseup', () => {
        if (isTtsEnabled) {
            const selectedText = window.getSelection().toString().trim();
            if (selectedText) {
                speakText(selectedText);
            }
        }
    });
</script>

<script>
    // Your OpenWeather API key
    const apiKey = 'c8136619d59b7ab631247d4b746ef5c7'; // Replace with your OpenWeather API key

    // Function to fetch weather data
    async function getWeather(city) {
        const url = `https://api.openweathermap.org/data/2.5/weather?q=${city}&appid=${apiKey}&units=imperial`; // units=metric for Celsius
        try {
            const response = await fetch(url);
            const data = await response.json();

            if (data.cod === 200) {
                // Display weather data
                document.getElementById('temperature').textContent = data.main.temp + '°F';
                document.getElementById('weatherDescription').textContent = data.weather[0].description;

                // Set the weather icon
                const iconCode = data.weather[0].icon;
                const iconUrl = `https://openweathermap.org/img/wn/${iconCode}.png`;
                document.getElementById('weatherIcon').src = iconUrl;
            } else {
                alert('City not found');
            }
        } catch (error) {
            console.error('Error fetching weather data:', error);
        }
    }

    // Example usage: Get weather for London
    getWeather('College Station');
</script>


<script>
    // Initial font size (in pixels)
    let currentFontSize = 18; // Default font size for the page
    const MIN_FONT_SIZE = 10;  // Minimum font size in pixels
    const MAX_FONT_SIZE = 30;  // Maximum font size in pixels

    document.getElementById('fontButton').addEventListener('click', () => {
        const fontControls = document.getElementById('fontControls');
        fontControls.style.display = fontControls.style.display === 'none' ? 'block' : 'none';
    });

    document.getElementById('fontSelect').addEventListener('change', (event) => {
        const selectedFont = event.target.value;
        document.body.style.fontFamily = selectedFont; // Change the font family for the entire page
    });

    document.getElementById('increaseFont').addEventListener('click', () => {
        if (currentFontSize < MAX_FONT_SIZE) { // Increase font size only if it's below the maximum limit
            currentFontSize += 2; // Increase font size by 2px
            document.documentElement.style.fontSize = `${currentFontSize}px`; // Apply font size to the root element (html)
        }
    });

    document.getElementById('decreaseFont').addEventListener('click', () => {
        if (currentFontSize > MIN_FONT_SIZE) { // Decrease font size only if it's above the minimum limit
            currentFontSize -= 2; // Decrease font size by 2px
            document.documentElement.style.fontSize = `${currentFontSize}px`; // Apply font size to the root element (html)
        }
    });
</script>

<script>
    // Toggle High Contrast
    document.getElementById('highContrastToggle').addEventListener('click', function() {
        document.body.classList.toggle('high-contrast');
        // Check if the body has the 'high-contrast' class and change the image source accordingly
        const translateIcon = document.getElementById('translate-icon');
        const ttsIcon = document.getElementById('tts-icon');
        const fontIcon = document.getElementById('font-icon');

        if (document.body.classList.contains('high-contrast')) {
            // If in high contrast mode, set the high contrast image
            translateIcon.src = 'https://flaticons.net/icon.php?slug_category=mobile-application&slug_icon=globe'; // Replace with your high contrast image URL
            ttsIcon.src = 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT7QGLGWRKUIJPADYTG2KjtXQqpaMOuhBKkDQ&s'; // Replace with your high contrast image URL
            fontIcon.src = 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQ9rPZ6V8Gn5NYYEkclnAFalcZMgfGAPBptMA&s'; // Replace with your high contrast image URL

            
        } else {
            // If not in high contrast mode, set the normal image
            translateIcon.src = 'https://cdn2.iconfinder.com/data/icons/social-media-line/50/global-512.png'; // Replace with your normal image URL
            ttsIcon.src = 'https://icons.iconarchive.com/icons/pictogrammers/material-light/256/volume-high-icon.png'; // Replace with your high contrast image URL
            fontIcon.src = 'https://www.svgrepo.com/show/465105/font-3.svg'; // Replace with your high contrast image URL

        }
    });
</script>
