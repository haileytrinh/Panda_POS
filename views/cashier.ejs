    * @description Adds a default empty bowl line onto the screen
    * @param {number} containerPrice - The price of the container is grabbed from the database
    */
    function bowlButton(containerPrice) {
        if (currentContainer == null) {
            currentContainer = "Bowl";

            const orderContainer = document.querySelector('.order-container-display');

            const line = document.createElement('div');
            line.classList.add('order-line');

            line.innerHTML = `
                <button class="delete-line">X</button>
                $${(containerPrice / 100).toFixed(2)} Bowl: [${bowlTracker[0]}, ${bowlTracker[1]}]
            `;

            line.querySelector('.delete-line').addEventListener('click', () => {
                const lineNumber = parseInt(line.dataset.lineNumber);
                deleteFromOrder(deleteId);
                line.remove();
            });

            orderContainer.appendChild(line);
            lineCounter++;
        } else {
            displayErrorMessage("Clear or Enter current container before starting a new one.");
        }
    }

