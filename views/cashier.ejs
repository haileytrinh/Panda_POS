    //Reset container states after an order is deleted
    /**
    * @function clearContainer
    * @description clears all the contents of the current container and sets everything back to its default state 
    */
    function clearContainer() {
        currentContainer = null;
        entreeNum = 0;
        sideNum = 0;
        drinkNum = 0;
        appetizerNum = 0;

        bowlTracker.fill("none");
        plateTracker.fill("none");
        biggerPlateTracker.fill("none");
        aLaCarteTracker.fill("none");
        drinkTracker.fill("none");
        appetizerTracker.fill("none");
        displayErrorMessage("Current container details are cleared, proceed with new container.");
    }

    // DON'T ADD THIS TO DOCUMENTATION
    function deleteFromOrder(containerId) {
        // just leave this here lowkey
    }

    /**
    * @function addFood
    * @description triggers the given general food method based on the type of food clicked
    * @param {string} foodName - the food name is grabbed from the clicked button
    * @param {string} itemType - the item type is grabbed from the database
    */
    function addFood(foodName, itemType) {
        if(currentContainer){
            if (itemType === 'entree'||itemType=='both') {
                generalEntreeButton(foodName);
            } else if (itemType === 'side') {
                generalSideButton(foodName);
            } else if (itemType === 'drink') {
                generalDrinkButton(foodName);  // Add the corresponding drink handling
            } else if (itemType === 'appetizer') {
                generalAppetizerButton(foodName);  // Add the corresponding drink handling
            }
        }
        else if(currentContainer == null){
            displayErrorMessage("ERROR: No Container Active.")
        }
    }

    // Function to handle the Appetizer container
    /**
    * @function generalAppetizerButton
    * @description correctly handles adding an appetizer to the appetizer container
    * @param {string} foodName - Used to update the display with the chosen food
    */
    function generalAppetizerButton(foodName) {
        // Check if the current container is one that allows entrees
        if (currentContainer === "Appetizer" && appetizerNum==0 ) {
            
            // Find the next empty spot in container tracker
            const nextIndex = appetizerTracker.findIndex(item => item === "none" || item === undefined);
            // Add the food name if there's an empty spot
            if (nextIndex !== -1) {
                appetizerTracker[nextIndex] = foodName;
                appetizerNum++;
                updateOrderDisplay();                      
            } else {
                displayErrorMessage("ERROR: Added too many appetizers. Clear or enter the current container.");
            }
        }
        else if(currentContainer != "Appetizer"){
            displayErrorMessage("ERROR: Cannot add appetizer to this container.");
        }
    }

    // Function to handle the Entree container
    /**
    * @function generalEntreeButton
    * @description correctly handles adding an entree to the active container
    * @param {string} foodName - Used to update the display with the chosen food
    */
    function generalEntreeButton(foodName) {
        // Check if the current container is one that allows entrees
        if (currentContainer === "Bowl" && entreeNum==0) {
            // Find the next empty spot in bowlTracker (assume it has a fixed length of 2)
            const nextIndex = bowlTracker.findIndex(item => item === "none" || item === undefined);
            // Add the food name if there's an empty spot
            if (nextIndex !== -1) {
                bowlTracker[nextIndex] = foodName;
                entreeNum++;
                updateOrderDisplay();                       
            }
        }
        else if(currentContainer === "Bowl" && entreeNum>1) {    
            displayErrorMessage("ERROR: Added too many entrees. Clear or complete the current container.");
        }
        if(currentContainer ==="Plate" && entreeNum<2){
            // Find the next empty spot in plateTracker
            const nextIndex = plateTracker.findIndex(item => item === "none" || item === undefined);
            // Add the food name if there's an empty spot
            if (nextIndex !== -1) {
                plateTracker[nextIndex] = foodName;
                entreeNum++;
                updateOrderDisplay();                   
            }
        }
        else if(currentContainer ==="Plate" && entreeNum>=2){
            displayErrorMessage("ERROR: Added too many entrees. Clear or complete the current container.");
        }
        if(currentContainer ==="Bigger Plate" && entreeNum<3){
            // Find the next empty spot in biggerPlateTracker 
            const nextIndex = biggerPlateTracker.findIndex(item => item === "none" || item === undefined);
            // Add the food name if there's an empty spot
            if (nextIndex !== -1) {
                biggerPlateTracker[nextIndex] = foodName;
                entreeNum++;
                updateOrderDisplay();                   
            }
        }
        else if(currentContainer ==="Bigger Plate" && entreeNum>=3){
            displayErrorMessage("ERROR: Added too many entrees. Clear or complete the current container.");
        }
        if(currentContainer ==="A-La-Carte" && entreeNum<1 && sideNum<1){
            // Find the next empty spot in bowlTracker (assume it has a fixed length of 2)
            const nextIndex = aLaCarteTracker.findIndex(item => item === "none" || item === undefined);
            // Add the food name if there's an empty spot
            if (nextIndex !== -1) {
                aLaCarteTracker[nextIndex] = foodName;
                entreeNum++;
                updateOrderDisplay();                   
            }
        }
        else if(currentContainer ==="A-La-Carte" && (entreeNum>=1 || sideNum >=1)){
            displayErrorMessage("ERROR: Added too many entrees. Clear or complete the current container.");
        }
        if(currentContainer == "Appetizer"|| currentContainer == "Drink"){
            displayErrorMessage("ERROR: Cannot add entree into this container.");
        }
    }
    //Function to handle drink container
    /**
    * @function generalDrinkButton
    * @description correctly handles adding a drink to the drink container
    * @param {string} foodName - Used to update the display with the chosen food
    */
    function generalDrinkButton(foodName) {
        if(currentContainer === "Drink" && drinkNum<1){
            // Find the next empty spot in bowlTracker (assume it has a fixed length of 2)
            const nextIndex = drinkTracker.findIndex(item => item === "none" || item === undefined);
            // Add the food name if there's an empty spot
            if (nextIndex !== -1) {
                drinkTracker[nextIndex] = foodName;
                drinkNum++;
                updateOrderDisplay();                   
            }
        }
        else if(currentContainer ==="Drink" && drinkNum==1){
            displayErrorMessage("ERROR: Added too many drinks. Clear or complete the current container.");
        }
        else if(currentContainer != "Drink") {
            displayErrorMessage("ERROR: Cannot add drink into this container.");
        }
    }

    // Function to handle the Side container
    /**
    * @function generalSideButton
    * @description correctly handles adding a side to the active container
    * @param {string} foodName - Used to update the display with the chosen food
    */
    function generalSideButton(foodName) {
        // Check if the current container is one that allows sides
        if ((currentContainer === "Bowl") && sideNum<1) {
            // Find the next empty spot in bowlTracker (assume it has a fixed length of 2)
            const nextIndex = bowlTracker.findIndex(item => item === "none" || item === undefined);
            // Add the food name if there's an empty spot
            if (nextIndex !== -1) {
                bowlTracker[nextIndex] = foodName;
                sideNum++;
                updateOrderDisplay();                  
            }
        }
        else if ((currentContainer === "A-La-Carte") && sideNum<1 && entreeNum<1) {
            // Find the next empty spot in aLaCarte (assume it has a fixed length of 1)
            const nextIndex = aLaCarteTracker.findIndex(item => item === "none" || item === undefined);
            // Add the food name if there's an empty spot
            if (nextIndex !== -1) {
                aLaCarteTracker[nextIndex] = foodName;
                sideNum++;
                updateOrderDisplay();                  
            }
        }
        else if ((currentContainer === "Plate") && sideNum<1) {
            // Find the next empty spot in bowlTracker (assume it has a fixed length of 2)
            const nextIndex = plateTracker.findIndex(item => item === "none" || item === undefined);
            // Add the food name if there's an empty spot
            if (nextIndex !== -1) {
                plateTracker[nextIndex] = foodName;
                sideNum++;
                updateOrderDisplay();                      
            }
        }
        else if ((currentContainer === "Bigger Plate") && sideNum<1) {
            // Find the next empty spot in bowlTracker (assume it has a fixed length of 2)
            const nextIndex = biggerPlateTracker.findIndex(item => item === "none" || item === undefined);
            // Add the food name if there's an empty spot
            if (nextIndex !== -1) {
                biggerPlateTracker[nextIndex] = foodName;
                sideNum++;
                updateOrderDisplay();
            }
        }
        else if((currentContainer === "Bowl"||currentContainer === "Plate"||currentContainer === "Bigger Plate") && sideNum==1){
            displayErrorMessage("ERROR: Added too many sides. Clear or complete the current container.");
        }
        else if(currentContainer ==="A-La-Carte" && (entreeNum>=1 || sideNum >=1)){
            displayErrorMessage("ERROR: Added too many sides. Clear or complete the current container.");
        }
        else if(currentContainer == "Appetizer"||currentContainer == "Drink" ){
            displayErrorMessage("ERROR: Cannot add a side to this container.");
        }
    }

    //Every time you add a food to the container, update order display is called to display the new arrays
    /**
    * @function updateOrderDisplay
    * @description updates the order text every time a cashier adds a new food to the order
    */
    function updateOrderDisplay() {
        const orderContainer = document.querySelector('.order-container-display');

        // Get all the lines in the order container
        const lines = orderContainer.querySelectorAll('.order-line');

        // Get the last line (if exists)
        const lastLine = lines[lines.length - 1];

        // Calculate the new line content
        let newLine = '';
        let containerType = '';
        let tracker = [];

        if (currentContainer === "Bowl") {
            tracker = bowlTracker;
            newLine = `$${(bowlPrice / 100).toFixed(2)} Bowl: [${tracker.join(', ')}]`;
            containerType = 'Bowl';
        } else if (currentContainer === "Plate") {
            tracker = plateTracker;
            newLine = `$${(platePrice / 100).toFixed(2)} Plate: [${tracker.join(', ')}]`;
            containerType = 'Plate';
        } else if (currentContainer === "Bigger Plate") {
            tracker = biggerPlateTracker;
            newLine = `$${(biggerPlatePrice / 100).toFixed(2)} Bigger Plate: [${tracker.join(', ')}]`;
            containerType = 'Bigger Plate';
        } else if (currentContainer === "A-La-Carte") {
            tracker = aLaCarteTracker;
            newLine = `$${(aLaCartePrice / 100).toFixed(2)} A-La-Carte: [${tracker.join(', ')}]`;
            containerType = 'A-La-Carte';
        } else if (currentContainer === "Appetizer") {
            tracker = appetizerTracker;
            newLine = `$${(appetizerPrice / 100).toFixed(2)} Appetizer: [${tracker.join(', ')}]`;
            containerType = 'Appetizer';
        } else if (currentContainer === "Drink") {
            tracker = drinkTracker;
            newLine = `$${(drinkPrice / 100).toFixed(2)} Drink: [${tracker.join(', ')}]`;
            containerType = 'Drink';
        }

        // If there's no line, create a new one
        if (!lastLine) {
            const line = document.createElement('div');
            line.classList.add('order-line');
            line.innerHTML = `
                <button class="delete-line" data-container="${containerType}">X</button>
                ${newLine}
            `;
            orderContainer.appendChild(line);
        } else {
            // Otherwise, update the last line
            lastLine.innerHTML = `
                <button class="delete-line" data-container="${containerType}">X</button>
                ${newLine}
            `;
        }

        // Reattach delete-line event listeners to all delete buttons
        const deleteButtons = orderContainer.querySelectorAll('.delete-line');
        deleteButtons.forEach(button => {
            button.removeEventListener('click', deleteLineHandler); // Remove any existing listeners to prevent duplicates
            button.addEventListener('click', deleteLineHandler);
        });
    }

    // Separate delete handler function FOR THE UPDATE ORDER DISPLAY X BUTTON
    function deleteLineHandler(event) {
        const button = event.currentTarget;
        const line = button.parentElement;
        const containerType = button.getAttribute('data-container');

        // Perform necessary deletion logic
        line.remove();
    }


    //gets all the previous lines except for the one we are trying to update which should be the most recent/last line
    /**
    * @function getAllButLastOrderLine
    * @description helper function the update the order display by grabbing all the confirmed lines except for the last line we are updating
    */
    function getAllButLastOrderLine() {
        const orderContainer = document.querySelector('.order-container-display');
        
        // Get the current HTML content of the order container
        const orderHTML = orderContainer.innerHTML.trim();
        
        // Check if there's any content in the order container
        if (orderHTML) {
            // Normalize <br> tags to ensure consistency
            const normalizedHTML = orderHTML.replace(/<br\s*\/?>/g, '<br>');
            
            // Split the content by <br> tag and filter out any empty lines
            const lines = normalizedHTML.split('<br>').filter(line => line.trim() !== '');
            
            // If there’s more than one line, return everything but the last
            if (lines.length > 1) {
                return lines.slice(0, -1).join('<br>');
            }
            
            // If there's only one line, return an empty string
            return '';
        }
        
        // Return an empty string if there is no text in the order container
        return '';
    }

</script>







