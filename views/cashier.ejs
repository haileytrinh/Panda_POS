<% layout('partials/cashierBoilerPlate') %>

<script>
    /**
    * @file        Cashier Ordering and Functionality
    * @desciption This EJS file includes functionalities for placing an order on the POS system
    */

    // Initialize each container
    const bowlTracker = ["none", "none"];       
    const plateTracker = ["none", "none", "none"];  
    const biggerPlateTracker = ["none", "none", "none", "none"]; 
    const aLaCarteTracker = ["none"];   
    const drinkTracker = ["none"];  
    const appetizerTracker = ["none"]; 

    // Tracks food items in a container
    let entreeNum = 0;
    let sideNum = 0;
    let appetizerNum = 0;
    let drinkNum = 0;

    // Track active container
    let currentContainer = null; 

    let lineCounter = 0; // Global counter to track line numbers for deletion on the order
    
    let totalPrice = 0;

    // Tracks the amount of each container in the order
    let numBowls = 0;
    let numPlates = 0;
    let numBiggerPlates = 0;
    let numALaCartes = 0;
    let numAppetizers = 0;
    let numDrinks = 0;

    // A-La-Carte trackers
    let entree = false;
    let side = false;

    /**
    * @function enterButton
    * @description Successfully validates an order and sets all the tracking variables back to its default state
    */
    function enterButton(){
        correct = false;
        if(currentContainer=="Bowl"){
            if(sideNum==1 && entreeNum==1){
                correct = true;
            }
        }
        else if(currentContainer == "Plate"){
            if(sideNum == 1 && entreeNum == 2){
                correct = true;
            }
        }
        else if(currentContainer == "Bigger Plate"){
            if(sideNum == 1 && entreeNum == 3){
                correct = true;
            }
        }
        else if(currentContainer =="A-La-Carte"){
            if(entreeNum == 1 && sideNum == 0){
                correct = true;
                entree = true;
            } else if (entreeNum == 0 && sideNum == 1) {
                correct = true;
                side = true;
            }
        }
        else if(currentContainer == "Appetizer"){
            if(appetizerNum == 1){
                correct = true;
            }
        }
        else if(currentContainer == "Drink"){
            if(drinkNum==1){
                correct = true;
            }
        }
        if(correct){
            // Updates the total price based on the completed container
            displayErrorMessage("Successfully added "+ currentContainer + "!");
            switch (currentContainer) {
            case "Appetizer":
                totalPrice += <%= container[0].price %>;
                document.getElementById('total-price').textContent = (totalPrice / 100).toFixed(2);
                break;
            case "Drink":
                totalPrice += <%= container[1].price %>;
                document.getElementById('total-price').textContent = (totalPrice / 100).toFixed(2);
                break;
            case "Bigger Plate":
                totalPrice += <%= container[5].price %>;
                document.getElementById('total-price').textContent = (totalPrice / 100).toFixed(2);
                break;
            case "Bowl":
                totalPrice += <%= container[3].price %>;
                document.getElementById('total-price').textContent = (totalPrice / 100).toFixed(2);
                break;
            case "Plate":
                totalPrice += <%= container[4].price %>;
                document.getElementById('total-price').textContent = (totalPrice / 100).toFixed(2);
                break;
            case "A-La-Carte":
                totalPrice += <%= container[2].price %>;
                document.getElementById('total-price').textContent = (totalPrice / 100).toFixed(2);
                break;
            default:
                displayErrorMessage("ERROR: Container not recognized.")
            }

            //reset all values back to default
            entreeNum = 0;
            sideNum = 0;
            drinkNum = 0;
            appetizerNum = 0;
            // Reset container arrays if needed
            bowlTracker.fill("none");
            plateTracker.fill("none");
            biggerPlateTracker.fill("none");
            aLaCarteTracker.fill("none");
            drinkTracker.fill("none");
            appetizerTracker.fill("none");
            currentContainer = null;
        }
        else{
            displayErrorMessage("ERROR: Incomplete container.");
        }
    }

    const maxOrderId = <%= maxOrderId %>;
    /**
    * @function checkOutButton
    * @description pushes all the valid orders on screen to the database, doesn't work if there is an unfinished container
    */
    let currentOrder = []; // Tracks containers for the current order
    async function checkOutButton() {
        // Loop through orderText and create containers
        const orderText = document.querySelector('.order-container-display').textContent.split('\n').filter((line) => line.includes(':'));
        for (let line of orderText) { // For each container in the order screen
            // Split the order line to extract container type and items
            var [containerName, itemsStr] = line.split(':');
            itemsStr = itemsStr.trim();
            containerName = containerName.trim().split(' ').slice(1).join(' ').trim();
            const items = itemsStr
                .replace(/^\[|\]$/g, '') // Remove surrounding brackets (if any)
                .split(',')              // Split by commas
                .map(item => item.trim()) // Trim extra spaces
                .filter(item => item !== ''); // Remove empty strings

            let containerInfo = [];
            
            // 0 - ID
            containerInfo.push(Date.now()); // Not really used anymore, mainly for continuity
            // 1 - Price
            if (containerName == "Appetizer") {
                containerInfo.push(<%= container[0].price %>);
                // 2 - Container Name
                containerInfo.push(containerName);
                // 3 - Entree, assuming side is selected first by cashier
                containerInfo.push();
                // 4 - Side
                containerInfo.push();
                // 5 - Appetizer/Drink
                containerInfo.push(items[0]);
            } else if (containerName == "Drink") {
                containerInfo.push(<%= container[1].price %>)
                // 2 - Container Name
                containerInfo.push(containerName);
                // 3 - Entree, assuming side is selected first by cashier
                containerInfo.push();
                // 4 - Side
                containerInfo.push();
                // 5 - Appetizer/Drink
                containerInfo.push(items[0]);
            } else if (containerName == "Bigger Plate") {
                containerInfo.push(<%= container[5].price %>);
                // 2 - Container Name
                containerInfo.push(containerName);
                // 3 - Entree, assuming side is selected first by cashier
                var entrees = [];
                entrees.push(items[1]);
                entrees.push(items[2]);
                entrees.push(items[3]);
                containerInfo.push(entrees);
                // 4 - Side
                containerInfo.push(items[0]);
                // 5 - Appetizer/Drink
                containerInfo.push([]);
            } else if (containerName == "Bowl") {
                containerInfo.push(<%= container[3].price %>);
                // 2 - Container Name
                containerInfo.push(containerName);
                // 3 - Entree, assuming side is selected first by cashier
                containerInfo.push(items[1]);
                // 4 - Side
                containerInfo.push(items[0]);
                // 5 - Appetizer/Drink
                containerInfo.push([]);
            } else if (containerName == "Plate") {
                containerInfo.push(<%= container[4].price %>);
                // 2 - Container Name
                containerInfo.push(containerName);
                // 3 - Entree, assuming side is selected first by cashier
                var entrees = [];
                entrees.push(items[1]);
                entrees.push(items[2]);
                containerInfo.push(entrees);
                // 4 - Side
                containerInfo.push(items[0]);
                // 5 - Appetizer/Drink
                containerInfo.push([]);
            } else if (containerName == "A-La-Carte") {
                containerInfo.push(<%= container[2].price %>);
                // 2 - Container Name
                containerInfo.push(containerName);
                if (entree == true) {
                    // 3 - Entree, assuming side is selected first by cashier
                    containerInfo.push(items[0]);
                    // 4 - Side
                    containerInfo.push([]);
                    // 5 - Appetizer/Drink
                    containerInfo.push([]);
                } else if (side == true) {
                    // 3 - Entree, assuming side is selected first by cashier
                    containerInfo.push([]);
                    // 4 - Side
                    containerInfo.push(items[0]);
                    // 5 - Appetizer/Drink
                    containerInfo.push([]);
                }
                entree = false;
                side = false;
            }

            // Adds container to order
            currentOrder.push(containerInfo);
        }

        // Get the exact date and time of the order
        const dateTime = new Date();
        const orderDate = dateTime.getFullYear() + `-` + (dateTime.getMonth() + 1) + `-` + dateTime.getDate();
        const orderTime = dateTime.getHours() + `:` + dateTime.getMinutes() + `:` + dateTime.getSeconds();
        const newOrderId = maxOrderId + 1;
        // Create complete order locally
        const customerOrder = {
            cart: currentOrder,
            order_id: newOrderId,
            employee_id: Math.floor((Math.random() * 4) + 1),
            date: orderDate,
            time: orderTime,
            is_in_process: 'f',
            status: "fulfilled"
        };

        fetch('/pushOrder', {
            body: JSON.stringify(customerOrder),
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json',
            },
        })
        .then(result => {
            alert('Order completed!');
            return fetch('/decrementStock', {
                body: JSON.stringify({ cart: customerOrder.cart }),
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                },
            });
        })
        .then(stockResult => stockResult.json())
        .then(data => {
            if (data.success) {
                //alert('Stock updated successfully!');
                window.location.reload();
            } else {
                alert(`Failed to update stock: ${data.message}`);
            }
        })
        .catch(error => {
            console.error('Error processing order:', error);
            alert('Error processing order.');
        });
    }
    //display any given error message onto the screen
    /**
    * @function displayErrorMessage
    * @description displays a given function's error message onto the POS screen for the cashier to see
    * @param {string} newErrorText- The text to be displayed
    */
    function displayErrorMessage(newErrorText) {
        const errorText = document.querySelector('.error-text'); // Make sure this matches your error message element's class or ID
        errorText.textContent = newErrorText;
    }
    // Function to handle adding a container based on type
    /**
    * @function addContainer
    * @description triggers the appropriate container button depending on what text is on the button
    * @param {string} containerName - The container name is grabbed from the clicked button
    * @param {number} containerPrice - The price of the container is grabbed from the database
    */
    function addContainer(containerName, containerPrice) {
        switch(containerName) {
            case "Appetizer":
                appetizerPrice = containerPrice;
                appetizerButton(containerPrice);
                break;
            case "Drink":
                drinkPrice = containerPrice;
                drinkButton(containerPrice);
                break;
            case "Bowl":
                bowlPrice = containerPrice;
                bowlButton(containerPrice);
                break;
            case "Plate":
                platePrice = containerPrice;
                plateButton(containerPrice);
                break;
            case "Bigger Plate":
                biggerPlatePrice = containerPrice;
                biggerPlateButton(containerPrice);
                break;
            case "A-La-Carte":
                aLaCartePrice = containerPrice;
                aLaCarteButton(containerPrice);
                break;
            default:
                //none
        }
    }
    //Function to handle selecting the Bowl container
    /**
