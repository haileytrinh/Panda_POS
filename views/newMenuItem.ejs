<% layout('partials/cashierBoilerPlate') %>

<a href="/menuEdit" class="btn btn-secondary btn-sm mb-3">
    ← Back</a>
<div class="container mb-5">
    <h4 class="text-center mb-4">New Menu Item</h4>

    <form id="newMenuItemForm" action="/newMenuItem" method="POST">
        <div class="mb-3">
            <label for="name" class="fw-bold form-label">Food Name:</label>
            <input type="text" id="name" name="name" class="form-control" value="" required>
        </div>

        <div class="mb-3">
            <label for="description" class="fw-bold form-label">Description:</label>
            <textarea id="description" name="description" class="form-control"
                placeholder="Describe your menu item. Ex: A delicate combination of chicken, mushrooms and zucchini wok-tossed with a light ginger soy sauce."
                required></textarea>
        </div>

        <div class="mb-3">
            <label for="restrictions" class="fw-bold form-label">Dietary Restrictions:</label>
            <textarea id="restrictions" name="restrictions" class="form-control"
                placeholder="Include any dietary restrictions. Ex: Contains Soybeans, Sesame, and Wheat."></textarea>
        </div>

        <div class="mb-3">
            <label for="type" class="fw-bold form-label">Type:</label>
            <select id="type" name="type" class="form-select" required>
                <option value="entree">Entree</option>
                <option value="side">Side</option>
                <option value="drink">Drink</option>
                <option value="appetizer">Appetizer</option>
            </select>
        </div>

        <div class="mb-3">
            <label for="seasonal" class="fw-bold form-label">Seasonal Item:</label>
            <select id="seasonal" name="seasonal" class="form-select" required>
                <option value="false">No</option>
                <option value="true">Yes</option>
            </select>
        </div>

        <div class="mb-3">
            <label for="calories" class="fw-bold form-label">Calories:</label>
            <input type="number" id="calories" name="calories" class="form-control" value="" required>
        </div>

        <div class="mb-3">
            <label for="image_url" class="fw-bold form-label">Image URL:</label>
            <input type="url" id="image_url" name="image_url" class="form-control"
                placeholder="https://example.com/image.jpg">
        </div>

        <button type="submit" class="btn btn-primary w-100">Create Menu Item</button>
    </form>
</div>

<script>
// Client-side validation before form submission
document.getElementById('newMenuItemForm').addEventListener('submit', function(event) {
    const calories = document.getElementById('calories').value;

    // Validate if 'calories' is a positive number
    if (isNaN(calories) || parseInt(calories) < 0) {
        // Show an alert if validation fails
        alert('Please enter a valid number for calories.');
        event.preventDefault();  // Prevent form submission
    }
});
</script>
