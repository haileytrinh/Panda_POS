<% layout('partials/cashierBoilerPlate') %>

    <script src="https://apis.google.com/js/platform.js" async defer></script>

    <a href="/employees" class="btn btn-secondary btn-sm mb-3">
        ← Back</a>
    <div class="container mb-5">
        <h4 class="text-center mb-4">New Employee</h4>


        <div class="mb-3">
            <label for="firstname" class="fw-bold form-label">Employee First Name</label>
            <input type="text" id="firstname" name="firstname" class="form-control" value="" required>
        </div>

        <div class="mb-3">
            <label for="lastname" class="fw-bold form-label">Employee Last Name</label>
            <input type="text" id="lastname" name="lastname" class="form-control" value="" required>
        </div>

        <div class="mb-3">
            <label for="is_manager" class="fw-bold form-label">Manager?</label>
            <select id="is_manager" name="is_manager" class="form-select" required>
                <option value=false>False</option>
                <option value=true>True</option>

            </select>
        </div>

        <div class="mb-3">
            <label for="phone_number" class="fw-bold form-label">Employee Phone Number</label>
            <input type="text" id="phone_number" name="phone_number" class="form-control" value="" required>
        </div>
        
        <script src="https://accounts.google.com/gsi/client" async defer></script>
        <div id="g_id_onload"
            data-client_id="478057859094-e6hs68hro3cb6usdl5ton929m9ho7ff9.apps.googleusercontent.com"
            data-callback="onSignIn"
            data-auto_select="false"
            data-prompt="select_account">
        </div>
        <div class="g_id_signin" data-type="standard"></div>


        <button id="the-submit-button" onclick="doSubmit()" class="btn btn-primary w-100" disabled>Create Employee</button>


    </div>

    <script>

    /**
    * @file        Employee form with information to add a new employee
    */
        var id = '';
        var email = '';
        /**
        * @function onSignIn
        * @description gets the employee ID from the basic profile
        * @param {object} response - returns an employee basic object and profile
        */
        function onSignIn(response) {
            fetch('/get-google-id', {
                body: JSON.stringify({idToken: response.credential}),
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                },
                method: 'POST'
            }).then(async response => {
                const payload = await response.json();
                id = payload.id;
                email = payload.email;
                document.getElementById('the-submit-button').disabled = false;
            }).catch(error => {
                alert(error.message);
            });
        }
        /**
        * @function doSubmit
        * @description submits the employee information to the database
        */
        function doSubmit() {
            fetch('/new-employee', {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    firstname: document.getElementById('firstname').value,
                    lastname: document.getElementById('lastname').value,
                    is_manager: document.getElementById('is_manager').value,
                    number: document.getElementById('phone_number').value,
                    id: id,
                    email: email
                })
            }).then(
                async response => {
                    window.location.href = '/employees/' + id;
                }
            ).catch(
                err => {
                    alert(err.message);
                }
            )
        }
    </script>