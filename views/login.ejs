<% layout('partials/loginBoilerPlate') %>

    <html>

    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <title>Card</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <script src="https://apis.google.com/js/platform.js" async defer></script>
    </head>

    <body>
        <div id="card">
            <div id="card-content">
                <div id="card-title" style="padding-top: 30px;">
                    <h2 style="font-size:x-large; padding-bottom: 10px; padding-left: 2px;" style="letter-spacing: normal;">Employee Login</h2>
                    <div class="underline-title"></div>
                </div>
                <script src="https://accounts.google.com/gsi/client" async defer></script>
                <div id="g_id_onload"
                    data-client_id="478057859094-e6hs68hro3cb6usdl5ton929m9ho7ff9.apps.googleusercontent.com"
                    data-callback="onSignIn"
                    data-auto_select="false"
                    data-prompt="select_account">
                </div>
                <div class="g_id_signin" data-type="standard"></div>
            </div>
    </body>

    <script>
        function onSignIn(response) {
            console.log('onSignIn called');
            const payload = JSON.parse(atob(response.credential.split('.')[1]));
            console.log('Google sub:', payload.sub);
            console.log('Email:', payload.email);

            fetch("/createsession", {
                method: "POST",
                body: JSON.stringify({ idToken: response.credential }),
                headers: { "Content-Type": "application/json" }
            }).then((result) => {
                if (result.status != 200) {
                    alert('Login unsuccessful');
                } else {
                    window.location.href = '/cashier';
                }
            }).catch((err) => { alert('Login unsuccessful'); });
        }
    </script>

    </html>

    <style>
        body {
            background-image: url('https://studiompls.com/wp-content/uploads/2020/07/PX_Timeline.jpg');
    background-size: cover; /* Optional: Makes the image cover the entire element */
    background-position: center center; /* Optional: Centers the image */
    background-repeat: no-repeat; /* Optional: Prevents repeating the image */
        }

        label {
            font-family: "Raleway", sans-serif;
            font-size: 11pt;
        }

        #card {
            background: #fbfbfb;
            border-radius: 8px;
            box-shadow: 1px 2px 8px rgba(0, 0, 0, 0.65);
            height: 410px;
            margin: 6rem auto 8.1rem auto;
            width: 329px;
        }

        #card-content {
            padding: 12px 44px;
        }

        #card-title {
            font-family: "Raleway Thin", sans-serif;
            letter-spacing: 4px;
            padding-bottom: 23px;
            padding-top: 13px;
            text-align: center;
        }

        #submit-btn {
            background: -webkit-linear-gradient(right, #e38386, #D1282E);
            border: none;
            border-radius: 21px;
            box-shadow: 0px 1px 8px #9d1d21;
            cursor: pointer;
            color: white;
            font-family: "Raleway SemiBold", sans-serif;
            height: 42.3px;
            margin: 0 auto;
            margin-top: 50px;
            transition: 0.25s;
            width: 153px;
        }

        #submit-btn:hover {
            box-shadow: 0px 1px 18px #9d1d21;
        }

        .form {
            align-items: left;
            display: flex;
            flex-direction: column;
        }

        .form-border {
            background: -webkit-linear-gradient(right, #e38386, #D1282E);
            height: 1px;
            width: 100%;
        }

        .form-content {
            background: #fbfbfb;
            border: none;
            outline: none;
            padding-top: 14px;
        }

        .underline-title {
            background: -webkit-linear-gradient(right, #e38386, #D1282E);
            height: 2px;
            margin: -1.1rem auto 0 auto;
            width: 230px;
        }
    </style>