    <script>
    /**
    * @file        Customer kiosk display page that allows customers to place orders
    */
        let entree1 = '';
        let entree2 = '';
        let entree3 = '';
        let selectEntrees = [];
        let selectSides = [];
        let selectAppetizer = [];
        let selectDrink = [];


        async function checkStock(itemID, itemtype) {
    try {
        // Make an HTTP request to the backend to check stock availability
        const response = await fetch(`/checkStock/${itemID}/${itemtype}`, {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        const result = await response.json();

        if (result.success) {
            return result.isInStock; // Return the boolean value from the backend
        } else {
            alert('Error checking stock availability.');
            return false; // Return false if there was an error
        }
    } catch (error) {
        console.error('Error:', error);
        alert('There was an error checking stock availability.');
        return false; // Return false in case of an error
    }
}



    /**
    * @function sendOrder
    * @description pushes the saved cart orders to the database
    * @param {string} containerType - Used to determine what container is being pushed
    */
        function sendOrder(containerType) {
            let orderId = Date.now();

            let orderInfo = [];

            if (containerType == "Bowl") {

                if (selectEntrees.length == 1 && selectSides.length == 1) {
                    orderInfo.push(orderId);
                    orderInfo.push(<%=  containerPrice %>);
                    orderInfo.push(containerType);

                    orderInfo.push(selectEntrees);
                    orderInfo.push(selectSides);
                }
                else {
                    alert("Please finish selection before adding to cart.");
                    event.preventDefault();
                    return;
                }
            }
            else if (containerType == "Plate") {

                if (selectEntrees.length == 2 && selectSides.length == 1) {
                    orderInfo.push(orderId);
                    orderInfo.push(<%=  containerPrice %>);
                    orderInfo.push(containerType);

                    orderInfo.push(selectEntrees);
                    orderInfo.push(selectSides);
                }
                else {
                    alert("Please finish selection before adding to cart.");
                    event.preventDefault();
                    return;
                }
            }
            else if (containerType == "Bigger Plate") {

                if (selectEntrees.length == 3 && selectSides.length == 1) {
                    orderInfo.push(orderId);
                    orderInfo.push(<%=  containerPrice %>);
                    orderInfo.push(containerType);

                    orderInfo.push(selectEntrees);
                    orderInfo.push(selectSides);
                }
                else {
                    alert("Please finish selection before adding to cart.");
                    event.preventDefault();
                    return;
                }
            }
            else if (containerType == "A-La-Carte") {
                if (selectEntrees.length == 1 || selectSides.length == 1) {
                    orderInfo.push(orderId);
                    orderInfo.push(<%=  containerPrice %>);
                    orderInfo.push(containerType);
                }
                else {
                    alert("Please finish selection before adding to cart.");
                    event.preventDefault();
                    return;
                }

                if (selectEntrees.length == 0) {
                    orderInfo.push(selectSides);
                }
                else {
                    orderInfo.push(selectEntrees);
                }
            }
            else if (containerType == "Appetizer") {
                if (selectAppetizer.length == 1) {
                    orderInfo.push(orderId);
                    orderInfo.push(<%=  containerPrice %>);
                    orderInfo.push(containerType);

                    orderInfo.push(selectAppetizer);
                }
                else {
                    alert("Please finish selection before adding to cart.");
                    event.preventDefault();
                    return;
                }
            }
            else if (containerType == "Drink") {
                if (selectDrink.length == 1) {
                    orderInfo.push(orderId);
                    orderInfo.push(<%=  containerPrice %>);
                    orderInfo.push(containerType);

                    orderInfo.push(selectDrink);
                }
                else {
                    alert("Please finish selection before adding to cart.");
                    event.preventDefault();
                    return;
                }

            }

            console.log(orderInfo);

            fetch('/add-to-cart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ order: orderInfo })
            })
                .then(response => response.json())
                .then(data => {
                    console.log('Order added to cart:', data);

                    selectEntrees = [];
                    selectSides = [];
                    selectAppetizer = [];
                    selectDrink = [];

                    //alert("Order Made!");
                    window.location.href = '/cart';

                })
                .catch(error => {
                    console.error('Error adding order to cart:', error);
                });
        }

        document.querySelectorAll('.clickable-card').forEach((card) => {
        card.addEventListener('click', async (event) => { // Make this function async
            const foodId = card.getAttribute('data-food-id'); // Access the food_id from the data attribute
            const itemName = card.getAttribute('data-name');  // Access the name of the food item
            const itemType = card.getAttribute('data-type'); 

            card.classList.toggle('active');
            
            console.log(`Food ID: ${foodId}`);
            console.log(`Item Name: ${itemName}`);
            console.log(`Item Type: ${itemType}`);

            // Call the checkStock function asynchronously
            const isInStock = await checkStock(foodId, itemType); // Pass the correct arguments

            if (!isInStock) {
        
                card.classList.remove('active'); // Optionally remove the active class if out of stock
                return; // Exit the function if the item is out of stock
            }

            // If the item is in stock, you can continue with your logic (e.g., add to the order, etc.)
            console.log(`${itemName} is in stock!`);
        });
    });


        /**
        * @function checkItems
        * @description makes sure the items added to the order are valid
        * @param {string} containerType - tracks the container
        * @param {string} itemType - tracks what type of food is being added
        * @param {string} itemName - tracks the food name
        * @param {string} containerAmt - tracks the price of the container
        */
        async function checkItems(containerType, itemType, itemName, containerAmt, itemID) {
            console.log(selectEntrees.length);

            const isInStock = await checkStock(itemID, itemType); // This calls the async function checkStock(itemID)
            if (!isInStock) {
                alert('This item is out of stock.');
            
                return; // Exit the function if the item is out of stock
            }
            console.log('clicked!');

            if (containerType == "Drink") {
                if (itemType == 'drink') {
                    if (selectDrink.length == 1) {
                        selectDrink = selectDrink.filter(item => item !== itemName);
                        enableAllItems(itemType);
                    }
                    else if (selectDrink.length < 1 || selectDrink.length < 1) {
                        selectDrink.push(itemName);
                        disableUnselectedItems(itemType);

                    }
                }
                console.log('Current Drinks:', selectDrink);

            }

            if (containerType == "Appetizer") {
                if (itemType == 'appetizer') {
                    if (selectAppetizer.length == 1) {
                        selectAppetizer = selectAppetizer.filter(item => item !== itemName);
                        enableAllItems(itemType);
                    }
                    else if (selectAppetizer.length < 1 || selectAppetizer.length < 1) {
                        selectAppetizer.push(itemName);
                        disableUnselectedItems(itemType);

                    }
                }

            }

            if (containerType == "A-La-Carte") {
                if (itemType == 'entree') {
                    if (containerAmt == 'entree1') {
                        if (entree1 !== itemName) {
                            entree1 = itemName;
                            selectEntrees.push(itemName);
                            disableUnselectedItems(containerAmt);
                            disableUnselectedItems('side');
                        } else {
                            entree1 = '';
                            const index = selectEntrees.indexOf(itemName);

                            if (index !== -1) {
                                selectEntrees.splice(index, 1);
                            }
                            enableAllItems(containerAmt);
                            enableAllItems('side');
                        }
                    }
                }

                if (itemType == 'side') {
                    if (selectSides.length == 1) {
                        selectSides = selectSides.filter(item => item !== itemName);
                        enableAllItems(itemType);
                        enableAllItems('entree1');
                    }
                    else if (selectSides.length < 1 || selectSides.length < 1) {
                        selectSides.push(itemName);
                        disableUnselectedItems(itemType);
                        disableUnselectedItems('entree1');
                    }
                }
            }
            if (containerType == "Bowl") {
                if (itemType == 'entree') {
                    if (containerAmt == 'entree1') {
                        if (entree1 !== itemName) {
                            entree1 = itemName;
                            selectEntrees.push(itemName);
                            disableUnselectedItems(containerAmt);
                        } else {
                            entree1 = '';
                            const index = selectEntrees.indexOf(itemName);

                            if (index !== -1) {
                                selectEntrees.splice(index, 1);
                            }
                            enableAllItems(containerAmt);
                        }
                    }
                }
                if (itemType == 'side') {
                    if (selectSides.length == 1) {
                        selectSides = selectSides.filter(item => item !== itemName);
                        enableAllItems(itemType);
                    }
                    else if (selectSides.length < 1) {
                        selectSides.push(itemName);
                        disableUnselectedItems(itemType);
                    }
                }
            }
            if (containerType == "Plate") {
                if (itemType == 'entree') {
                    if (containerAmt == 'entree1') {
                        if (entree1 !== itemName) {
                            entree1 = itemName;
                            selectEntrees.push(itemName);
                            disableUnselectedItems(containerAmt);
                        } else {
                            entree1 = '';
                            const index = selectEntrees.indexOf(itemName);

                            if (index !== -1) {
                                selectEntrees.splice(index, 1);
                            }
                            enableAllItems(containerAmt);
                        }
                    }

                    else if (containerAmt == 'entree2') {
                        if (entree2 !== itemName) {
                            entree2 = itemName;
                            selectEntrees.push(itemName);
                            disableUnselectedItems(containerAmt);
                        } else {
                            entree2 = '';
                            const index = selectEntrees.indexOf(itemName);

                            if (index !== -1) {

                                selectEntrees.splice(index, 1);
                            }
                            enableAllItems(containerAmt);  // Re-enable items if the entree is deselected
                        }
                    }
                }

                if (itemType == 'side') {
                    if (selectSides.length == 1) {
                        selectSides = selectSides.filter(item => item !== itemName);
                        enableAllItems(itemType);
                    }
                    else if (selectSides.length < 1) {
                        selectSides.push(itemName);
                        disableUnselectedItems(itemType);
                    }
                }
            }

            if (containerType == "Bigger Plate") {
                if (itemType == 'entree') {
                    if (containerAmt == 'entree1') {
                        if (entree1 !== itemName) {
                            entree1 = itemName;
                            selectEntrees.push(itemName);
                            disableUnselectedItems(containerAmt);
                        } else {
                            entree1 = '';
                            const index = selectEntrees.indexOf(itemName);

                            if (index !== -1) {
                                selectEntrees.splice(index, 1);
                            }
                            enableAllItems(containerAmt);
                        }
                    }

                    else if (containerAmt == 'entree2') {
                        if (entree2 !== itemName) {
                            entree2 = itemName;
                            selectEntrees.push(itemName);
                            disableUnselectedItems(containerAmt);
                        } else {
                            entree2 = '';
                            const index = selectEntrees.indexOf(itemName);

                            if (index !== -1) {

                                selectEntrees.splice(index, 1);
                            }
                            enableAllItems(containerAmt);  // Re-enable items if the entree is deselected
                        }
                    }
                    else if (containerAmt == 'entree3') {
                        if (entree3 !== itemName) {
                            entree3 = itemName;
                            selectEntrees.push(itemName);
                            disableUnselectedItems(containerAmt);
                        } else {
                            entree2 = '';
                            const index = selectEntrees.indexOf(itemName);

                            if (index !== -1) {

                                selectEntrees.splice(index, 1);
                            }
                            enableAllItems(containerAmt);  // Re-enable items if the entree is deselected
                        }
                    }
                }

                if (itemType == 'side') {
                    if (selectSides.length == 1) {
                        selectSides = selectSides.filter(item => item !== itemName);
                        enableAllItems(itemType);
                    }
                    else if (selectSides.length < 1) {
                        selectSides.push(itemName);
                        disableUnselectedItems(itemType);
                    }
                }
            }
        }

        /**
        * @function disableUnselectedItems
        * @description doesn't allow customer to select any more food after they have made a choice
        * @param {string} itemType - tracks what type of food is being added
        */
        function disableUnselectedItems(itemType) {
            const items = document.querySelectorAll(`.card-${itemType}`);

            items.forEach((card) => {
                const itemName = card.dataset.name;  // Get the unique name of the item

                if ((itemType === 'entree1' && entree1 != itemName) ||
                    (itemType === 'entree2' && entree2 != itemName) ||
                    (itemType === 'entree3' && entree3 != itemName) ||
                    (itemType === 'side' && !selectSides.includes(itemName)) ||
                    (itemType === 'appetizer' && !selectAppetizer.includes(itemName)) ||
                    (itemType === 'drink' && !selectDrink.includes(itemName))) {
                    // Disable this card if the name is not in the selected list
                    card.style.pointerEvents = 'none';
                    card.style.opacity = '0.5';
                    card.classList.add('disabled');
                } else {
                    // Enable this card if the name is in the selected list
                    card.style.pointerEvents = 'auto';
                    card.style.opacity = '1';
                    card.classList.remove('disabled');
                }
            });
        }
        /**
        * @function enableAllItems
        * @description refresh and enable all items for choosing
        * @param {string} itemType - tracks what type of food is being added
        */
        function enableAllItems(itemType) {
            const allCards = document.querySelectorAll(`.card-${itemType}`);  // Select all entree and side cards

            allCards.forEach(card => {
                // Reset the styles and remove the 'disabled' class
                card.style.pointerEvents = 'auto';   // Enable clicking
                card.style.opacity = '1';            // Reset opacity
                card.classList.remove('disabled');  // Remove any 'disabled' class
            });
        }
    </script>

    <script type="text/javascript">
        // TRANSLATE SCRIPT
        // Function to translate text using Google Translate API
        async function translateText(text, targetLanguage) {
            const res = await fetch('/translate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    text: text,
                    targetLanguage: targetLanguage
                })
            });

            const data = await res.json();
            return data.translatedText;
        }

        // Store original content for reverting
        const originalContent = document.getElementById('content-container').innerHTML;

        // Retrieve saved language preference or default to English
        const savedLanguage = localStorage.getItem('language') || 'en';
        let currentLanguage = savedLanguage;

        // Function to apply saved translation on page load
        async function applySavedTranslation() {
            const contentContainer = document.getElementById('content-container');
            if (currentLanguage !== 'en') {
                const translatedContent = await translateText(originalContent, currentLanguage);
                contentContainer.innerHTML = translatedContent;
            }
        }

        // Run this function on page load to apply saved language
        document.addEventListener('DOMContentLoaded', applySavedTranslation);

        // Handle language change
        async function changeLanguage(language) {
            const contentContainer = document.getElementById('content-container');
            if (language === 'en') {
                contentContainer.innerHTML = originalContent;
            } else {
                const translatedContent = await translateText(originalContent, language);
                contentContainer.innerHTML = translatedContent;
            }
            localStorage.setItem('language', language);
            currentLanguage = language;
        }

        // Dropdown menu toggle
        document.getElementById('translateButton').addEventListener('click', () => {
            const languageMenu = document.getElementById('languageMenu');
            languageMenu.style.display = languageMenu.style.display === 'block' ? 'none' : 'block';
        });

        // Add event listeners for language options
        document.getElementById('englishOption').addEventListener('click', () => changeLanguage('en'));
        document.getElementById('spanishOption').addEventListener('click', () => changeLanguage('es'));
        document.getElementById('chineseOption').addEventListener('click', () => changeLanguage('zh'));
        document.getElementById('frenchOption').addEventListener('click', () => changeLanguage('fr'));

        // Close the dropdown when clicking anywhere outside it
        window.addEventListener('click', (event) => {
            const languageMenu = document.getElementById('languageMenu');
            if (!event.target.matches('#translateButton') && !event.target.matches('#languageMenu') && !event.target.matches('#languageMenu *')) {
                languageMenu.style.display = 'none';
            }
        });
    </script>

    <script type="text/javascript">
        // Flag to track TTS toggle status
        let isTtsEnabled = false;

        // Function to toggle text-to-speech
        document.getElementById('ttsToggle').addEventListener('click', () => {
