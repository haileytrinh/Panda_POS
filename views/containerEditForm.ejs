<% layout('partials/cashierBoilerPlate') %>
    <a href="/containerEdit" class="btn btn-secondary btn-sm mb-3">
        ← Back</a>
    <div class="container mb-3">
        <h4 class="text-center mb-4">Editing <%= container.container_name %>
        </h4>

        <form action="/containerEdit/<%= container.container_name %>/edit?_method=PUT" method="POST">
            <div class="mb-3">
                <label for="name" class="fw-bold form-label">Container Name:</label>
                <input type="text" id="name" name="name" class="form-control" value="<%= container.container_name %>"
                    required>
            </div>

            <div class="mb-3">
                <label for="description" class="fw-bold form-label">Description:</label>
                <textarea id="description" name="description" class="form-control"
                    required><%= container.description %></textarea>
            </div>

            <div class="mb-3">
                <label for="price" class="fw-bold form-label">Price:</label>
                <input type="number" id="price" name="price" class="form-control"
                    value="<%= (container.price / 100).toFixed(2)%>" step="0.01" min="0" required>
            </div>

            <div class="mb-3">
                <label for="image" class="fw-bold form-label">Image URL:</label>
                <input type="url" id="image" name="image" class="form-control" value="<%= container.image %>">
            </div>

            <button type="submit" class="btn btn-primary w-100">Save Changes</button>
        </form>