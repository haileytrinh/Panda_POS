<% layout('partials/formBoilerPlate') %>

<a href="/" class="btn btn-secondary btn-sm mb-3">
    ← Back</a>
<div class="container mb-5">
    <h4 class="text-center mb-4">Customer Complaint Form</h4>

    <form action="/submitComplaint" method="POST">
        <!-- Name Input -->
        <div class="mb-3">
            <label for="name" class="fw-bold form-label">Your Name:</label>
            <input type="text" id="name" name="name" class="form-control" placeholder="Enter your full name" required>
        </div>

        <!-- Email Input -->
        <div class="mb-3">
            <label for="email" class="fw-bold form-label">Your Email:</label>
            <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email address" required>
        </div>

        <!-- Complaint Textarea -->
        <div class="mb-3">
            <label for="complaint" class="fw-bold form-label">Your Complaint:</label>
            <textarea id="complaint" name="complaint" class="form-control" rows="5" placeholder="Describe your issue or feedback here" required></textarea>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary w-100">Submit Complaint</button>
    </form>
</div>
