<% layout('partials/boilerplate') %>
<style>

    /* High Contrast Mode Styles */
    .high-contrast {
        background-color: #000 !important;
        color: #fff !important;
    }
    .high-contrast a {
        color: #ff0 !important;
    }
    .high-contrast .card {
        background-color: #d02020 !important;
    }
    .high-contrast .card-body {
        color: #fff !important;
    }
    .high-contrast .btn {
        background-color: rgb(255, 201, 52) !important;
        color: #000 !important;
    }

    .high-contrast .modal-content  {
        background-color: #000 !important;
        color: #000 !important;
    }
    .high-contrast .card-title, 
    .high-contrast .card-text,
    .high-contrast .modal-title,
    .high-contrast .menu-description,
    .high-contrast .side-title,
    .high-contrast p {
        color: #fff !important; /* Ensure text is white in high contrast mode */
    }
</style>


<div style="display: flex; justify-content: space-between; align-items: center;">
    <!-- Left Section: Translate and TTS Buttons -->
    <div style="display: flex; align-items: center; gap: 20px;">
        <!-- Translate Section -->
        <div style="position: relative; display: inline-block;">
            <!-- Translate Button -->
            <button id="translateButton" aria-label="Translate" style="border: none; background: none;">
                <img id="translate-icon" alt="Translate" src="https://cdn2.iconfinder.com/data/icons/social-media-line/50/global-512.png" style="width: 30px; height: 30px;">
            </button>
    
            <!-- Dropdown Menu -->
            <div id="languageMenu" alt= "Language Dropdown" style="display: none; position: absolute; background-color: white; border: 1px solid #ccc; box-shadow: 0px 8px 16px rgba(0,0,0,0.2); z-index: 1;">
                <button class="language-option" data-language="en" style="width: 100%; border: none; background: none; padding: 10px;">English</button>
                <button class="language-option" data-language="es" style="width: 100%; border: none; background: none; padding: 10px;">Spanish</button>
                <button class="language-option" data-language="zh" style="width: 100%; border: none; background: none; padding: 10px;">Chinese</button>
                <button class="language-option" data-language="fr" style="width: 100%; border: none; background: none; padding: 10px;">French</button>
            </div>
        </div>
    
        <!-- TTS Section -->
        <button id="ttsToggle" aria-label="Text-to-Speech" style="border: none; background: none;">
            <img id="tts-icon" alt="Text-to-Speech" src="https://icons.iconarchive.com/icons/pictogrammers/material-light/256/volume-high-icon.png" style="width: 40px; height: 40px;">
        </button>
    
        <!-- Font Settings Section -->
        <div>
            <button id="fontButton" style="border: none; background: none;">
                <img id="font-icon" src="https://www.svgrepo.com/show/465105/font-3.svg" alt="Font Icon" style="width: 30px; height: 30px;">
            </button>
            <div id="fontControls" style="display: none; margin-top: 10px; background-color: #cbcbcb; padding: 10px; border: 1px solid #ccc; border-radius: 5px; width: fit-content;">
                <label for="fontSelect" style="margin: 5px; font-size: 14px;">Change Font:</label>
                <select id="fontSelect" style="margin: 5px; font-size: 14px;">
                    <option value="Arial">Arial</option>
                    <option value="Verdana">Verdana</option>
                    <option value="Times New Roman">Times New Roman</option>
                    <option value="Georgia">Georgia</option>
                    <option value="Courier New">Courier New</option>
                </select>
                <button id="increaseFont" style="margin: 5px; border: none; background: none;">
                    <img src="https://cdn0.iconfinder.com/data/icons/typicons-2/24/plus-128.png" alt="Font Increase Icon" style="width: 20px; height: 20px;">
                </button>
                <button id="decreaseFont" style="margin: 5px; border: none; background: none;">
                    <img src="https://cdn0.iconfinder.com/data/icons/typicons-2/24/minus-128.png" alt="Font Decrease Icon" style="width: 20px; height: 20px;">
                </button>
                
            </div>
        </div>

        <!-- High Contrast Toggle Button -->
        <button id="highContrastToggle" class="btn btn-warning" style="border: none; background: none;">
            High Contrast
        </button>
    </div>
    
    <!-- Right Section: Weather Icon and Info -->
    <div id="weather" style="display: flex; align-items: center; text-align: right;">
        <img id="weatherIcon" src="" alt="Weather icon" style="width: 60px; height: 60px; margin-right: 10px;">
        <div style="display: flex; flex-direction: column; text-align: left;">
            <p style="margin-bottom: 2px; font-size: 14px;"><span id="temperature"></span></p>
            <p style="margin-top: 2px; margin-bottom: 0; text-transform: capitalize; font-size: 14px;"><span
                    id="weatherDescription"></span></p>
        </div>
    </div>
</div>


